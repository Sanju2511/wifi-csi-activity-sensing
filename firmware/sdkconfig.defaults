# CSI support (without it esp_wifi_set_csi_config fails and the board reboots)
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP32_WIFI_CSI_ENABLED=y

# No Wi-Fi power save, to keep the 100 packets/s timing regular
CONFIG_ESP_WIFI_PS_NONE=y

# 115200 baud is too slow for 100 CSI lines/s, so use 921600
# (the baud setting only applies when the custom UART console is selected)
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
